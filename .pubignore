# pub uses this file instead of .gitignore when publishing, so it repeats it.

# Mirrored from .gitignore
*.class
*.log
*.pyc
*.swp
*.iml
*.ipr
*.iws
migrate_working_dir/
**/doc/api/
build/
CLAUDE.md

# Local / generated output
coverage/
pubspec_overrides.yaml
/example/test_results/

# Contributor-only material
/CONTRIBUTING.md
/overview.md
/plan/

# The package's own unit tests (example/test is kept: it shows generated output)
/test/

# Flutter platform runners of the example app; regenerate with `flutter create .`
/example/android/
/example/ios/
/example/windows/
