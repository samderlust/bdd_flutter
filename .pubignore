# When this file exists, `dart pub publish` uses it INSTEAD of the root
# .gitignore, so any non-hidden pattern from .gitignore must be repeated here.
#
# Pub already excludes, without needing an entry here:
#   - every hidden file/directory (`.*`): .dart_tool/, .github/, .vscode/,
#     .idea/, .DS_Store, .claude/, .cursor/, .flutter-plugins*, ...
#   - every pubspec.lock, and the root pubspec_overrides.yaml
#
# Check the result with `dart pub publish --dry-run`.

# Mirrored from .gitignore
*.class
*.log
*.pyc
*.swp
*.iml
*.ipr
*.iws
migrate_working_dir/
**/doc/api/
build/
CLAUDE.md

# Local / generated output
coverage/
pubspec_overrides.yaml

# Contributor-only material
/CONTRIBUTING.md
/overview.md
/plan/

# The package's own unit tests (example/test is kept: it shows generated output)
/test/

# Flutter platform runners of the example app; regenerate with `flutter create .`
/example/android/
/example/ios/
/example/windows/
